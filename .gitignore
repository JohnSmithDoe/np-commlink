# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

.nx

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt


/.sourcemaps
/.versions
/coverage

# Ionic
/.ionic
/www
/platforms
/plugins

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# Environment
.env
.env.*

# Capacitor / Android — the native project IS committed. `cap add android`
# is not reproducible: a newer @capacitor/cli scaffolds a different tree, and
# android-postsync.sh only pins the values it was told about. android/.gitignore
# ships with Capacitor and excludes the generated half (build output, the copied
# web assets, local.properties).

# The collected release APK (scripts/collect-apk.sh). A build output, not a
# source artifact: ~28 MB per build, and the published copy is the one attached
# to the tag by hand — committing it would grow the repo by a full APK per
# release for a file nobody clones the repo to get.
/releases

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*


# Miscellaneous
/.angular
/.angular/cache
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings
*.iml
# System files
.DS_Store
Thumbs.db

# Qodana reports (generated)
/qodana.sarif.json

# SonarScanner work dir (generated)
/.scannerwork

# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Merge-planning workspace (transient; delete once execution done)
/.plan-workspace

# Session handover and point-in-time review (transient; delete once the work in
# them has shipped). Not further documents: docs/ holds what outlives a task,
# a current-*.md holds one task, or one snapshot of the tree. The prefix is the
# contract — eslint.config.js ignores the same pattern, so a scratch doc cannot
# turn the lint gate red.
/current-*.md
# codegraph
.codegraph

# Bank exports are real account data — keep them local, never commit one again
docs/cash/*.csv

# eslint --cache (per-file result cache; CI always runs cold)
.eslintcache

# APK signing identity — never committable. A key in git is not "removable":
# anyone who ever had it can sign an upgrade Android installs over the real one,
# so exposure means every user reinstalls from scratch. Keys live outside the
# repo and reach Gradle as NPC_* env vars (scripts/android-postsync.sh patch 5).
*.jks
*.keystore
keystore.properties
