/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    // Chrome's built-in AI globals (LanguageModel & co) are ambient declarations,
    // so they must be listed explicitly — this project opts out of auto-inclusion.
    "types": ["dom-chromium-ai"]
  },
  "files": ["src/main.ts", "src/polyfills.ts"],
  "include": ["src/**/*.d.ts"]
}
