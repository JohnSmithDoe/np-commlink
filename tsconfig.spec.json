/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // The deck catalog's spec asserts that every theme ships every label, which
    // means reading the message catalogs themselves.
    "resolveJsonModule": true,
    // Inherited `true`, off here on purpose. What the flag buys in app code is
    // that a missed bounds check becomes a compile error instead of an
    // `undefined` reaching a reducer. A spec indexes a fixture it built three
    // lines earlier, and an `undefined` there is not a silent fault — it is a red
    // test with a TypeError, which is the signal the assertion exists to produce.
    // Paying for it would mean `?.` on ~140 assertions, which reads worse and
    // weakens the failure message for a guarantee the runner already gives.
    "noUncheckedIndexedAccess": false,
    "types": ["vitest/globals", "dom-chromium-ai"]
  },
  "files": ["src/polyfills.ts"],
  // Every `testing/` dir, not just `@shared`'s: Sheriff reaches them from
  // `*.spec.ts` alone, so a fixture is spec code and wants spec options. Nine
  // domains held theirs under the app project, where `noUncheckedIndexedAccess`
  // makes a fixture's own lookup of its own table an error.
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "src/app/*/testing/**/*.ts"],
  "exclude": []
}
