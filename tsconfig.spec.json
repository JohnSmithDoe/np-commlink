/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // The deck catalog's spec asserts that every theme ships every label, which
    // means reading the message catalogs themselves.
    "resolveJsonModule": true,
    "types": ["vitest/globals", "dom-chromium-ai"]
  },
  "files": ["src/polyfills.ts"],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/app/@shared/testing/**/*.ts"
  ],
  "exclude": []
}
