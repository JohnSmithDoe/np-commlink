/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/e2e",
    // Playwright transpiles the specs with esbuild, which strips types without
    // reading them — so without this project nothing type-checks `e2e/` at all.
    // It went unnoticed because the two `tsc` gates are scoped to `src`, and no
    // `no-unused-vars` is configured, which left `noUnusedLocals` — a compiler
    // flag, and so project-scoped — as the only thing that could have spoken.
    //
    // Inherited `true`, off here for the same reason `tsconfig.spec.json` turns
    // it off: a spec indexes a fixture it built three lines earlier, and an
    // `undefined` there is a red test with a TypeError, not a silent fault.
    "noUncheckedIndexedAccess": false
  },
  // The specs only — `playwright.config.ts` is driven by Playwright, not built.
  // Node's globals reach exactly the projects that name them: `types` is set on
  // tsconfig.json and inherited here, so auto-inclusion is off everywhere and
  // `@types/node` is inert until a project asks. Only e2e/handbook does.
  "include": ["e2e/**/*.ts"],
  // `e2e/handbook/**` is a screenshot GENERATOR, not specs: `*.shots.ts` never
  // matches `pnpm run e2e`, it writes PNGs instead of asserting, and it is
  // driven by its own playwright.handbook.config.ts. It wants Node's `Buffer`,
  // which is the one thing this project exists to keep out, so it holds its own
  // tsconfig instead — see the banner there.
  //
  // Excluded rather than fixed at the call site: `STATEMENT_XML` is BUILT from
  // `ENTRIES`, `IBAN` and `CLOSING`, so the notes.e2e.ts trick of passing a
  // committed file path would fork the fixture from the constants generating it.
  "exclude": ["e2e/handbook/**"]
}
