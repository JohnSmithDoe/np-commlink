{
  "name": "np-commlink",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "author": "Leto da c0dem0nkey",
  "description": "np-commlink — shadowrun deck merging tracking + kitchen into one shell",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./ --configuration production",
    "build:android": "ionic capacitor build android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "test:coverage": "ng test --no-watch --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint": "ng lint",
    "serve:prod": "ionic serve --prod",
    "i18n:extract": "ngx-translate-extract --input ./src --output src/assets/i18n/de.json --clean --sort --format json"
  },
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/service-worker": "^21.2.18",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@colsen1991/ngx-translate-extract-marker": "^2.0.8",
    "@ionic/angular": "^8.8.13",
    "@ionic/core": "^8.8.13",
    "@ionic/storage-angular": "^4.0.0",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/router-store": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.13",
    "ionicons": "^7.2.2",
    "ng2-charts": "^9.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.19",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@angular/language-service": "^21.2.18",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.5",
    "@ionic/angular-toolkit": "^12.3.0",
    "@ngrx/eslint-plugin": "^21.1.1",
    "@playwright/test": "^1.61.1",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vendure/ngx-translate-extract": "^10.1.3",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
