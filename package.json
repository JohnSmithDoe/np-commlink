{
  "name": "np-commlink",
  "version": "1.6.0",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "author": "Leto the c0dem0nkey",
  "description": "np-commlink — shadowrun deck merging tracking + kitchen into one shell",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./ --configuration production --define NPC_RELEASE=\"'$npm_package_version'\"",
    "build:pages": "ng build --base-href /np-commlink/ --configuration production --define NPC_RELEASE=\"'$npm_package_version'\"",
    "apk:sync": "cap sync android && ./scripts/android-postsync.sh",
    "apk:build": "pnpm run build && pnpm run apk:sync",
    "apk:debug": "pnpm run apk:build && cd android && ./gradlew assembleDebug",
    "apk:release": "pnpm run apk:build && cd android && ./gradlew assembleRelease && ../scripts/collect-apk.sh",
    "apk:signed": "./scripts/sign-release.sh",
    "apk:open": "cap open android",
    "verify": "sheriff verify src/main.ts",
    "verify:testids": "node scripts/check-testids.mjs",
    "verify:icons": "node scripts/check-icons.mjs",
    "verify:docs": "node scripts/check-doc-paths.mjs",
    "verify:exports": "node scripts/check-exports.mjs",
    "verify:pages": "node scripts/check-pages-build.mjs",
    "verify:all": "./scripts/verify-all.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "test:coverage": "ng test --no-watch --coverage",
    "test:plugin": "vitest run --config vitest.plugin.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint": "pnpm run lint:plugin-types && pnpm run lint:eslint && pnpm run lint:styles",
    "lint:eslint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.{scss,css}\"",
    "lint:plugin-types": "tsc -p eslint-plugin-commlink/tsconfig.json",
    "emoji:build": "node scripts/build-emoji-data.mjs",
    "jam:update": "./scripts/update-jam-client.sh",
    "handbook:shots": "node scripts/build-handbook-shots.mjs",
    "i18n:extract": "ngx-translate-extract --input ./src -o 'public/i18n/{de,en,fr}.json' --clean --sort --format-indentation '  ' --trailing-newline --format json",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"public/i18n/*.json\" \"eslint-plugin-commlink/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"public/i18n/*.json\" \"eslint-plugin-commlink/**/*.{ts,json}\"",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@colsen1991/ngx-translate-extract-marker": "^3.0.1",
    "@ionic/angular": "^9.0.8",
    "@ionic/core": "^9.0.8",
    "@ionic/storage-angular": "^4.0.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "ionicons": "^8.1.0",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ngrx/eslint-plugin": "^22.0.1",
    "@playwright/test": "^1.64.1",
    "@softarc/eslint-plugin-sheriff": "^0.20.0",
    "@softarc/sheriff-core": "^0.20.0",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "26.6.5",
    "@vendure/ngx-translate-extract": "^10.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^78.0.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
